{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "44rem",
      "wideSize": "80rem"
    },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": true,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "brand", "color": "#5B3DF5", "name": "Brand violet" },
        { "slug": "brand-soft", "color": "#EDE9FE", "name": "Brand soft" },
        { "slug": "accent", "color": "#D8F14B", "name": "Accent lime" },
        { "slug": "ink", "color": "#0B0B0F", "name": "Ink" },
        { "slug": "ink-soft", "color": "#5A5F6E", "name": "Ink soft" },
        { "slug": "ink-muted", "color": "#8A8F9E", "name": "Ink muted" },
        { "slug": "paper", "color": "#FFFFFF", "name": "Paper" },
        { "slug": "canvas", "color": "#F6F5F2", "name": "Canvas" },
        { "slug": "sunken", "color": "#EFEEE9", "name": "Sunken" },
        { "slug": "line", "color": "#E5E3DD", "name": "Hairline" },
        { "slug": "success", "color": "#0E9F6E", "name": "Success" },
        { "slug": "danger", "color": "#E0334B", "name": "Danger" }
      ],
      "gradients": [
        {
          "slug": "ink-fade",
          "gradient": "linear-gradient(180deg, rgba(11,11,15,0) 0%, rgba(11,11,15,0.9) 100%)",
          "name": "Ink fade"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "lineHeight": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Inter",
          "fontFamily": "Inter, system-ui, -apple-system, sans-serif"
        },
        {
          "slug": "heading",
          "name": "Inter Tight",
          "fontFamily": "'Inter Tight', Inter, system-ui, sans-serif"
        },
        {
          "slug": "display",
          "name": "Instrument Serif",
          "fontFamily": "'Instrument Serif', Georgia, serif"
        },
        {
          "slug": "mono",
          "name": "IBM Plex Mono",
          "fontFamily": "'IBM Plex Mono', ui-monospace, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.8125rem", "name": "Small" },
        { "slug": "medium", "size": "0.9375rem", "name": "Body" },
        { "slug": "large", "size": "1.3125rem", "name": "Large" },
        { "slug": "x-large", "size": "1.75rem", "name": "Heading" },
        { "slug": "xx-large", "size": "2.25rem", "name": "Display" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "2" },
        { "slug": "30", "size": "1rem", "name": "4" },
        { "slug": "40", "size": "1.5rem", "name": "6" },
        { "slug": "50", "size": "2rem", "name": "8" },
        { "slug": "60", "size": "3rem", "name": "12" },
        { "slug": "70", "size": "4rem", "name": "16" }
      ]
    },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "card", "name": "Card", "shadow": "0 2px 10px rgba(11,11,15,0.06)" },
        { "slug": "lift", "name": "Lift", "shadow": "0 8px 24px rgba(11,11,15,0.08)" },
        { "slug": "pop", "name": "Pop", "shadow": "0 20px 48px rgba(11,11,15,0.14)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "padding": { "left": "1rem", "right": "1rem" },
      "blockGap": "1.25rem"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--brand)" },
        ":hover": { "typography": { "textDecoration": "underline" } }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "letterSpacing": "-0.02em"
        },
        "color": { "text": "var(--wp--preset--color--ink)" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--brand)",
          "text": "#FFFFFF"
        },
        "border": { "radius": "0.625rem" },
        "typography": { "fontWeight": "600" },
        ":hover": { "color": { "background": "#4A2ED6" } }
      }
    },
    "blocks": {
      "core/quote": {
        "border": { "left": { "color": "var(--wp--preset--color--brand)", "width": "4px", "style": "solid" } },
        "spacing": { "padding": { "left": "1.25rem" } }
      },
      "core/code": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "#FFFFFF"
        },
        "border": { "radius": "0.875rem" }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--line)" }
      }
    }
  }
}
