#!/usr/bin/env php
<?php
/**
 * Cartly DS — design-system command line.
 *
 * A single PHP binary that owns the design-system tasks that used to be spread
 * across Node (Tailwind), bash (`sync-tokens.sh`) and Python (`lint-php.py`):
 *
 *   bin/cartly tokens      Dump the design tokens (JSON / CSS / table).
 *   bin/cartly css         Compile tokens + components into one distributable CSS.
 *   bin/cartly styleguide  Generate a self-contained, responsive styleguide HTML.
 *   bin/cartly check       Token-drift guard (non-zero exit on drift).
 *   bin/cartly build       Run the css + styleguide pipeline into ./dist.
 *   bin/cartly help|--help Usage.
 *   bin/cartly --version   Version.
 *
 * Pure PHP. Requires only the PHP CLI (>= 7.4) — no Composer, no extensions,
 * no Node, no shell, no Python.
 *
 * @package CartlyDS
 */

if ( PHP_SAPI !== 'cli' ) {
	exit( 'This tool must be run from the command line.' . PHP_EOL );
}

// Resolve the repo root (parent of this bin/ directory).
$root = dirname( __DIR__ );

// --- Minimal PSR-4-style autoloader for CartlyDS\ ---
spl_autoload_register( static function ( $class ) use ( $root ) {
	$prefix = 'CartlyDS\\';
	if ( 0 !== strpos( $class, $prefix ) ) {
		return;
	}
	$rel = substr( $class, strlen( $prefix ) );
	$file = $root . '/src/CartlyDS/' . str_replace( '\\', '/', $rel ) . '.php';
	if ( is_file( $file ) ) {
		require $file;
	}
} );

use CartlyDS\Compiler;
use CartlyDS\Drift;
use CartlyDS\Styleguide;
use CartlyDS\Tokens;

$version = '1.0.0';
$tokensPath = $root . '/assets/src/tokens.css';

/**
 * Command-line argument helper.
 */
function arg( int $i, array $argv, string $default = '' ): string {
	return $argv[ $i ] ?? $default;
}

/**
 * Print usage.
 */
function usage( string $version ): void {
	$name = basename( $GLOBALS['argv'][0] );
	echo <<<TXT
Cartly DS $version — design-system tool (pure PHP)

Usage:
  $name tokens [--json]           Dump design tokens (table, or JSON).
  $name css [--out file] [--minify]
                                  Compile tokens + components to one CSS file.
  $name styleguide [--out file]   Generate a self-contained styleguide HTML.
  $name check [--baseline file]   Compare tokens to a baseline; non-zero on drift.
  $name build [--out dir]         Run css + styleguide into the given directory.
  $name --version                 Print version.
  $name help                      Show this help.

Examples:
  $name tokens --json
  $name css --out assets/css/cartly.css --minify
  $name styleguide --out dist/styleguide.html
  $name check --baseline design/tokens.json
  $name build --out dist
TXT;
	echo PHP_EOL;
}

/**
 * Parse `--key value` args from the tail of argv.
 *
 * @param array<int,string> $argv
 * @return array<string,string>
 */
function parseOptions( array $argv, array $names ): array {
	$opts = array();
	$n = count( $argv );
	for ( $i = 0; $i < $n; $i++ ) {
		$a = $argv[ $i ];
		if ( 0 === strpos( $a, '--' ) ) {
			$key = substr( $a, 2 );
			$val = true;
			if ( $i + 1 < $n && 0 !== strpos( $argv[ $i + 1 ], '--' ) ) {
				$val = $argv[ $i + 1 ];
			} elseif ( 0 === strpos( $a, '--out' ) && false !== strpos( $a, '=' ) ) {
				$key = 'out';
				$val = substr( $a, strlen( '--out=' ) );
			}
			$opts[ $key ] = $val;
		}
	}
	return $opts;
}

/* ---------------------------------------------------------------- dispatch -- */

$argv = $_SERVER['argv'] ?? array();
$cmd  = strtolower( arg( 1, $argv, 'help' ) );

$opts = parseOptions( array_slice( $argv, 2 ), array( 'out', 'json', 'css', 'minify', 'baseline' ) );

switch ( $cmd ) {
	case '--version':
	case 'version':
		echo "Cartly DS {$version}\n";
		exit( 0 );

	case 'help':
	case '--help':
	case '-h':
		usage( $version );
		exit( 0 );

	case 'tokens':
		$tokens = Tokens::fromCssFile( $tokensPath );
		if ( isset( $opts['json'] ) ) {
			echo json_encode( $tokens->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES ) . "\n";
			break;
		}
		renderTokenTable( $tokens );
		break;

	case 'css':
		$tokens = Tokens::fromCssFile( $tokensPath );
		$compiler = new Compiler( $tokens );
		$css = $compiler->compile( isset( $opts['minify'] ) );
		$out = $opts['out'] ?? $root . '/dist/cartly.css';
		writeOut( $out, $css, "CSS compiled to", $root );
		break;

	case 'styleguide':
		$tokens = Tokens::fromCssFile( $tokensPath );
		$compiler = new Compiler( $tokens );
		$css = $compiler->compile( false );
		$guide = new Styleguide( $tokens, $css );
		$html = $guide->render();
		$out = $opts['out'] ?? $root . '/dist/styleguide.html';
		writeOut( $out, $html, "Styleguide written to", $root );
		break;

	case 'build':
		$tokens = Tokens::fromCssFile( $tokensPath );
		$compiler = new Compiler( $tokens );
		$outDir = $opts['out'] ?? $root . '/dist';
		if ( ! is_dir( $outDir ) && ! mkdir( $outDir, 0777, true ) && ! is_dir( $outDir ) ) {
			fwrite( STDERR, "Error: cannot create {$outDir}\n" );
			exit( 1 );
		}
		$css = $compiler->compile( true );
		$html = ( new Styleguide( $tokens, $compiler->compile( false ) ) )->render();
		file_put_contents( $outDir . '/cartly.css', $css );
		file_put_contents( $outDir . '/styleguide.html', $html );
		echo "Built:\n  {$outDir}/cartly.css\n  {$outDir}/styleguide.html\n";
		break;

	case 'check':
		$tokens = Tokens::fromCssFile( $tokensPath );
		$baselinePath = $opts['baseline'] ?? $root . '/design/tokens.json';
		$baseline = loadBaseline( $baselinePath, $root );
		$drift = new Drift();
		$diff = $drift->compare( $tokens, $baseline );
		echo $drift->render( $diff );
		exit( $diff ? 1 : 0 );

	default:
		fwrite( STDERR, "Unknown command: {$cmd}\n\n" );
		usage( $version );
		exit( 1 );
}

/**
 * Write a file, resolving a relative path against the repo root.
 */
function writeOut( string $out, string $contents, string $label, string $root ): void {
	$path = $out;
	if ( 0 !== strpos( $path, '/' ) ) {
		$path = $root . '/' . $out;
	}
	$dir = dirname( $path );
	if ( ! is_dir( $dir ) && ! mkdir( $dir, 0777, true ) && ! is_dir( $dir ) ) {
		fwrite( STDERR, "Error: cannot create {$dir}\n" );
		exit( 1 );
	}
	if ( false === file_put_contents( $path, $contents ) ) {
		fwrite( STDERR, "Error: cannot write {$path}\n" );
		exit( 1 );
	}
	echo "{$label}: {$path}\n";
}

/**
 * Render a human-readable token table (light, dark, hex).
 *
 * @param Tokens $tokens
 */
function renderTokenTable( Tokens $tokens ): void {
	$all = $tokens->toArray();
	echo str_pad( 'TOKEN', 26 ) . str_pad( 'LIGHT', 18 ) . str_pad( 'DARK', 18 ) . "HEX LIGHT\n";
	echo str_repeat( '-', 78 ) . "\n";
	foreach ( $all['light'] as $name => $channels ) {
		$short = 0 === strpos( $name, 'c-' ) ? substr( $name, 2 ) : $name;
		$dark  = $tokens->channels( $short, 'dark' ) ?? $channels;
		printf(
			"%-26s %-18s %-18s %s\n",
			$name,
			$channels,
			$dark,
			Tokens::toHex( $channels )
		);
	}
}

/**
 * Load a baseline. Supports a JSON baseline if it decodes, otherwise tries a
 * tokens.css-style file.
 *
 * @param string $path
 * @param string $root
 * @return Tokens
 */
function loadBaseline( string $path, string $root ): Tokens {
	if ( 0 !== strpos( $path, '/' ) ) {
		$path = $root . '/' . $path;
	}
	if ( ! is_file( $path ) ) {
		fwrite( STDERR, "Error: baseline not found: {$path}\n" );
		exit( 1 );
	}
	$content = file_get_contents( $path );
	$json = json_decode( (string) $content, true );
	if ( is_array( $json ) && isset( $json['light'] ) ) {
		return new Tokens( $json['light'] ?? array(), $json['dark'] ?? array(), $json['raw'] ?? array() );
	}
	// Fall back to a tokens.css-style file.
	return Tokens::fromCss( (string) $content );
}
