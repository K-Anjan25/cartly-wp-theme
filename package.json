{
  "name": "cartly-wp-theme",
  "version": "2.0.0",
  "private": true,
  "description": "Build pipeline for the Cartly WordPress theme stylesheet.",
  "scripts": {
    "build": "tailwindcss -i ./assets/src/theme.css -o ./assets/css/cartly.css --minify",
    "dev": "tailwindcss -i ./assets/src/theme.css -o ./assets/css/cartly.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.4"
  }
}
